DATABASE_URL=postgres://postgres:postgres@localhost:5432/titeny
# Wajib, minimal 32 karakter (HS256). Jangan commit nilai produksi.
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
# Opsional: pepper digest PIN zona (default diturunkan dari JWT_SECRET).
# PIN_PEPPER=
# Batas permintaan per menit per token (default 60).
# RATE_LIMIT_PER_MENIT=60
# HANYA dev: cetak OTP ke log karena kanal pengiriman produksi belum ada.
# OTP_LOG_DEV=true
# BIND_ADDR=0.0.0.0:8080
